@baseUrl = http://localhost:5002
# A token from UserService: POST http://localhost:5001/api/users/login, copy "token".
@token = paste-a-token-here

GET {{baseUrl}}/health

###

# 200 when the database and blob storage answer, 503 when they do not.
GET {{baseUrl}}/health/ready

###

GET {{baseUrl}}/api/playlists
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/api/playlists/1
Authorization: Bearer {{token}}

###

# Admin only (token with role = Admin).
POST {{baseUrl}}/api/playlists
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "80s" }

###

PUT {{baseUrl}}/api/playlists/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Eighties" }

###

# Also deletes the songs that are in no other playlist, and their files.
DELETE {{baseUrl}}/api/playlists/1
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/api/artists?search=queen
Authorization: Bearer {{token}}

###

# Admin only.
POST {{baseUrl}}/api/artists
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Queen" }

###

# Admin only. Upload an mp3 (put song.mp3 next to this file).
POST {{baseUrl}}/api/playlists/1/songs
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="title"

Under Pressure
--boundary
Content-Disposition: form-data; name="artistIds"

1
--boundary
Content-Disposition: form-data; name="year"

1981
--boundary
Content-Disposition: form-data; name="file"; filename="song.mp3"
Content-Type: audio/mpeg

< ./song.mp3
--boundary--

###

# Admin only.
GET {{baseUrl}}/api/playlists/1/songs
Authorization: Bearer {{token}}

###

# Admin only. Applies in every playlist the song is in.
PUT {{baseUrl}}/api/songs/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "title": "Under Pressure", "artistIds": [1, 2], "year": 1981 }

###

# Admin only. Deletes the song and its file if it is in no other playlist.
DELETE {{baseUrl}}/api/playlists/1/songs/1
Authorization: Bearer {{token}}

###

# For GameService (any token).
GET {{baseUrl}}/api/playlists/1/songs/random?count=6
Authorization: Bearer {{token}}
