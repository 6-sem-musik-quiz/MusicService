@baseUrl = http://localhost:5002
# A token from UserService: POST http://localhost:5001/api/users/login, copy "token".
@token = paste-a-token-here

GET {{baseUrl}}/health

###

# 200 when the database and blob storage answer, 503 when they do not.
GET {{baseUrl}}/health/ready

###

GET {{baseUrl}}/api/playlists
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/api/playlists/1
Authorization: Bearer {{token}}

###

# Admin only (token with role = Admin).
POST {{baseUrl}}/api/playlists
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "80s" }

###

PUT {{baseUrl}}/api/playlists/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Eighties" }

###

# Also deletes the songs that are in no other playlist, and their files.
DELETE {{baseUrl}}/api/playlists/1
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/api/artists?search=queen
Authorization: Bearer {{token}}

###

# Admin only.
POST {{baseUrl}}/api/artists
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Queen" }
